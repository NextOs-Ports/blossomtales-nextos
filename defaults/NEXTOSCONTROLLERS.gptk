# NEXTOSCONTROLLERS — controles do NextOS / NextOS controls
# Formato próprio do NextOS. NÃO é gptokeyb: nunca vira teclado.
# NextOS own format. NOT gptokeyb: never becomes a keyboard.
#
# Mapa estático dos controles nativos. Este port NÃO carrega edições deste
# arquivo em runtime; SDL/PortMaster permanece a fonte dos controles.
# Static map of native controls. This port does NOT load edits from this
# file at runtime; SDL/PortMaster remains the controls source.

format = NEXTOS_CONTROLLERS/3
port = blossomtales

FACE_LAYOUT = auto

[menu]
A = menu.accept
B = menu.back
X = player.use_tool
Y = player.open_menu
L1 = player.select_previous
R1 = player.select_next
L2 = null
R2 = null
L3 = player.open_journal
R3 = player.open_map
START = system.pause
SELECT = system.back
UP = menu.navigate_up
DOWN = menu.navigate_down
LEFT = menu.navigate_left
RIGHT = menu.navigate_right
LEFT_STICK = null
RIGHT_STICK = null

[gameplay]
A = player.attack
B = player.use_item
X = player.use_tool
Y = player.open_menu
L1 = player.select_previous
R1 = player.select_next
L2 = null
R2 = null
L3 = player.open_journal
R3 = player.open_map
START = system.pause
SELECT = system.back
UP = player.move_up
DOWN = player.move_down
LEFT = player.move_left
RIGHT = player.move_right
LEFT_STICK = null
RIGHT_STICK = null
